#!/bin/sh
# Защита от захвата чужой работы параллельной сессией.
#
# 24.08.2026: одна сессия Claude Code сделала `git add -A`, и в её коммит
# уехали незакоммиченные файлы другой сессии, работавшей в том же дереве.
# Код не пропал, но история стала врать про то, что к чему относится.
#
# Хук не запрещает большие коммиты — он требует, чтобы человек (или агент)
# на них ПОСМОТРЕЛ. Осознанный большой коммит проходит с флагом:
#
#     NEXUS_BIG_COMMIT=1 git commit -m "..."
#
# Ставится через `make hooks` (см. Makefile).

# Сколько файлов в коммите считаем поводом остановиться и посмотреть.
# Обычный коммит по одной задаче в этом проекте — 3-8 файлов.
LIMIT=${NEXUS_COMMIT_LIMIT:-12}

if [ -n "$NEXUS_BIG_COMMIT" ]; then
    exit 0
fi

staged=$(git diff --cached --name-only | wc -l)

if [ "$staged" -le "$LIMIT" ]; then
    exit 0
fi

echo ""
echo "  ОСТАНОВЛЕНО: в коммите $staged файлов (порог $LIMIT)."
echo ""
echo "  Похоже на 'git add -A' — так в коммит попадает работа соседней"
echo "  сессии, которая прямо сейчас идёт в этом же каталоге."
echo ""
echo "  Что в коммите:"
git diff --cached --name-only | sed 's/^/    /'
echo ""
echo "  Если это ваши файлы и коммит правда такой большой:"
echo "    NEXUS_BIG_COMMIT=1 git commit ..."
echo ""
echo "  Если нет — снимите чужое и коммитьте своё явными путями:"
echo "    git reset                       # снять всё со сцены"
echo "    git add путь/к/своему/файлу     # добавить только своё"
echo ""

exit 1
