# Шаблон конфигурации Nexus OS. Скопируйте в .env и заполните.
# .env в .gitignore — реальные ключи в репозиторий не попадают.

# --- Telegram (Hermes) ---
# Токен выдаёт @BotFather. Если токен где-то засветился — /revoke и новый.
TELEGRAM_BOT_TOKEN=
# Ваш числовой id, узнать у @UserInfobot. Бот отвечает только вам (I-7).
TELEGRAM_ALLOWED_USER_ID=

# --- Провайдеры Пантеона ---
# Каждая персона ходит в свою модель; без ключа персона откатывается
# на модель по умолчанию, диалог при этом не ломается.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini нужен для расшифровки голосовых сообщений
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Модель по умолчанию ---
NEXSYS_LLM_PROVIDER=ollama
NEXSYS_LLM_MODEL=llama3.1:8b
NEXSYS_LLM_BASE_URL=http://localhost:11434

# --- Деньги (I-4) ---
# Дневной потолок расходов на LLM в долларах. При превышении фоновые
# задачи останавливаются до полуночи UTC, диалог продолжает работать.
NEXUS_DAILY_LLM_BUDGET_USD=5

# --- Интеграции ---
NEXSYS_APOLLO_API_KEY=
OBSIDIAN_VAULT_PATH=
HERMES_ARTIFACTS_PATH=./artifacts

# --- Сервис ---
NEXSYS_API_PORT=8420
NEXSYS_FRONTEND_PORT=5173
NEXSYS_LOG_LEVEL=INFO
